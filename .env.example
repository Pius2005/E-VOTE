# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sug_vote"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sug_vote"
# Random long string used to sign session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Random long string used as an HMAC pepper for OTP hashing. Generate with: openssl rand -hex 32
OTP_PEPPER=""

# Resend (https://resend.com) API key for sending OTP / password reset emails.
# Leave blank in development to log emails to the console instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="SUG VOTE <no-reply@example.edu>"

# Public URL of the deployed app (used in CORS and reset-link generation)
APP_URL="http://localhost:3000"

# WebAuthn / passkey configuration
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="SUG VOTE"
WEBAUTHN_ORIGIN="http://localhost:3000"
